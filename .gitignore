# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Data (large, regenerable from source -- not committed)
data/*
!data/.gitkeep

# Model checkpoints (large binaries -- track via releases/DVC/git-lfs, not plain git)
models/**/*.pt
models/**/*.pth
models/**/*.onnx
!models/**/.gitkeep

# Results that are regenerated by scripts (keep raw CSV/JSON if you want them
# versioned; figures/tables are regenerable so ignored by default)
results/figures/*.png
results/figures/*.pdf
results/raw/logs/

# OS / editor
.DS_Store
.idea/
.vscode/

# Docker
*.log
